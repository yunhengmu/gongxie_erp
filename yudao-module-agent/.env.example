# ============================================================
# 环境变量配置
# 只需填写跟 settings.py 默认值不同的字段。
# settings.py 里已有默认值的项，可以省略不写。
# ============================================================

# ========== 必须配置（无默认值） ==========
DEEPSEEK_API_KEY=sk-your-key-here

# ========== 常用可选覆盖 ==========
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.5
# APP_PORT=8000
# APP_DEBUG=false
# MEMORY_TYPE=in_memory
# STORE_TYPE=in_memory          # in_memory | postgres（长期记忆/跨会话）
# API_KEY=                 # 可选，设置后 API 请求需 Bearer 认证
# ========== Tools ==========
# SEARCH_PROVIDER=duckduckgo     # duckduckgo | tavily
# TAVILY_API_KEY=tvly-xxx
# SEARCH_MAX_RESULTS=5

# ========== Vector Store ==========
# EMBEDDING_MODEL=BAAI/bge-m3
# CHROMA_PERSIST_DIR=./.chroma
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# ========== Redis（可选） ==========
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ========== MySQL（可选） ==========
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=rag

# ========== Microservices（可选） ==========
# 微服务地址，配置后 Agent 可调用微服务接口
# ORDER_SERVICE_URL=http://localhost:9001
# INVENTORY_SERVICE_URL=http://localhost:9002
# USER_SERVICE_URL=http://localhost:9003
# NOTIFICATION_SERVICE_URL=http://localhost:9004
# INTERNAL_API_TOKEN=your-internal-token  # 微服务间鉴权 Token（LLM 不可见）

# ========== RAG ==========
# RAG_HYBRID_SEARCH=true
# RAG_TOP_K=5
# RAG_RERANK_ENABLED=false
# BERT_MODEL_NAME=bert-base-chinese

# ========== LangSmith 追踪（可选） ==========
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-xxx