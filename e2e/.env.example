# e2e 本地配置（不入库）。复制本文件为 .env.local 后填入真实值。
# 注意：仅 BIZBUDDY_LLM_API_KEY 是机密，其余均有默认值。

# 后端直连地址（容器栈默认 8080；Windows 侧请用 localhost，不要用 127.0.0.1）
BIZBUDDY_BASE_URL=http://localhost:8080

# 登录账号（默认超管；见 deploy/docker-compose.yml 注释）
BIZBUDDY_USERNAME=admin
BIZBUDDY_PASSWORD=admin123

# 客户端 id（取自 plus-ui-Vue/.env.development 的 VITE_APP_CLIENT_ID）
BIZBUDDY_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e

# 接口加密密钥对：留空时自动读取 plus-ui-Vue/.env.development 的 VITE_APP_RSA_*（前端已公开，非机密）
# BIZBUDDY_RSA_PUBLIC_KEY=
# BIZBUDDY_RSA_PRIVATE_KEY=

# ★ 唯一的机密：模型 API key（阿里云百炼）。**仅 L1 需要**（作为瞬时入参下发、不落库）。
#   留空时 L1 SKIP；L2~L6 走平台「模型配置」里已保存的密钥，不受此项影响；L7~L11 不触发模型调用。
BIZBUDDY_LLM_API_KEY=

# 可选覆盖：模型标识与服务地址（默认取平台「模型配置」里已保存的预置模型，无需填写）
# BIZBUDDY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BIZBUDDY_CHAT_MODEL_NAME=deepseek-v4-pro-0813
# BIZBUDDY_EMBEDDING_MODEL_NAME=qwen3.7-text-embedding-flash

# 可选覆盖：演示种子编码（用于动态解析 id）
# BIZBUDDY_DEMO_KB_CODE=bizbuddy_demo_kb
# BIZBUDDY_DEMO_DOC_NAME=BizBuddy简介.txt
# BIZBUDDY_DEMO_EXPERT_CODE=bizbuddy_intro_expert
# BIZBUDDY_NOTICE_EXPERT_CODE=notice_admin_expert

# ---------------------------------------------------------------- 决策模型（TypeSafe System One 协议）
# 仅 e2e/jev/check-systemone.mjs（专家路由接入前的连通性验证）使用；不参与 run.mjs。
# API Key 缺省回退 BIZBUDDY_LLM_API_KEY（百炼同一把密钥），通常无需重复填写。
# 百炼决策模型的 endpoint 带业务空间子域名，BIZBUDDY_JEV_WORKSPACE_ID 从百炼控制台获取。
# BIZBUDDY_JEV_WORKSPACE_ID=
# BIZBUDDY_JEV_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode
# BIZBUDDY_JEV_MODEL=decision-model-preview
