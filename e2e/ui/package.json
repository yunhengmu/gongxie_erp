{
  "name": "bizbuddy-e2e-ui",
  "version": "0.1.0",
  "private": true,
  "description": "BizBuddy 前端关键路径端到端测试（Playwright）。测的是**已部署的容器栈**，与 ../http（零依赖 HTTP 层）互补；浏览器依赖较重，故独立目录承载，不污染 ../http 的零依赖。",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:pg": "playwright test --project=chromium",
    "install-browser": "playwright install chromium",
    "report": "playwright show-report .artifacts/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
