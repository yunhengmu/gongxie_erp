# ==========================================================================================
# BizBuddy 部署变量（复制为 .env 后生效；不复制则使用 docker-compose.yml 内的默认值）
#
#   cp .env.example .env
#
# 注意：PostgreSQL 的建库脚本只在数据卷为空的首次启动时执行；
#       改完这些变量后如需重建库，请执行 `docker compose down -v` 再起。
# ==========================================================================================

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 对外端口
WEB_PORT=80
BACKEND_PORT=8080
SNAILJOB_DASHBOARD_PORT=8800
SNAILJOB_SERVER_PORT=17888
POSTGRES_PORT=5432
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# ---------------------------------------------------------------- 数据库
POSTGRES_DB=biz_buddy
POSTGRES_USER=postgres
# 与 jdbc 密码保持一致；含特殊字符时无需转义（纯作为字符串使用）
POSTGRES_PASSWORD=Zl@2026

# ---------------------------------------------------------------- 缓存
REDIS_PASSWORD=Zl@2026

# ---------------------------------------------------------------- 向量库
# Milvus standalone 默认开启鉴权，超级用户 root / Milvus
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus

# Milvus 依赖的对象存储镜像。MinIO 官方已停止在 Docker Hub 发布，
# Milvus 官方编排里钉的旧 tag 已拉不到，故此处默认用仍可拉取的 release。
# 若拉取失败，可改用社区 fork：pgsty/minio:RELEASE.2026-04-17T00-00-00Z
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z

# ---------------------------------------------------------------- 后端
# 建库脚本会创建 dev / prod 两个 SnailJob 命名空间，取值须与其中之一一致
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx1024m
