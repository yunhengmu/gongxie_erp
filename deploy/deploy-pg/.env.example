# ==========================================================================================
# BizBuddy 部署变量（复制为 .env 后生效）
# 不复制也有 docker-compose.yml 内的默认值可用，但**密钥 / 口令类仍为出厂示例值**，
# 启动自检会拒绝启动——见文末「出厂默认值收口自检」。
#
#   cp .env.example .env
#
# 注意：PostgreSQL 的建库脚本只在数据卷为空的首次启动时执行；
#       改完这些变量后如需重建库，请执行 `docker compose down -v` 再起。
# ==========================================================================================

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 对外端口
WEB_PORT=80
BACKEND_PORT=8080
SNAILJOB_DASHBOARD_PORT=8800
SNAILJOB_SERVER_PORT=17888
POSTGRES_PORT=5432
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# ---------------------------------------------------------------- 数据库
POSTGRES_DB=biz_buddy
POSTGRES_USER=postgres
# 与 jdbc 密码保持一致；含特殊字符时无需转义（纯作为字符串使用）
POSTGRES_PASSWORD=Zl@2026

# ---------------------------------------------------------------- 缓存
REDIS_PASSWORD=Zl@2026

# ---------------------------------------------------------------- 平台对象存储（OSS）
# RuoYi 的文件上传与知识库文档存在这里（配置在数据库 sys_oss_config，由 50-oss-endpoint.sql 指向 minio:9000）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OSS_ACCESS_KEY=ruoyi
OSS_SECRET_KEY=ruoyi123
OSS_BUCKET=ruoyi

# ---------------------------------------------------------------- 向量库
# Milvus standalone 默认开启鉴权，超级用户 root / Milvus
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus

# MinIO 镜像（平台 OSS 使用；Milvus 复用同一实例，不再单独起容器）。
# MinIO 官方已停止在 Docker Hub 发布，Milvus 官方编排里钉的旧 tag 已拉不到，故此处默认用仍可拉取的 release。
# 若拉取失败，可改用社区 fork：pgsty/minio:RELEASE.2026-04-17T00-00-00Z
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z

# ---------------------------------------------------------------- 后端
# 建库脚本会创建 dev / prod 两个 SnailJob 命名空间，取值须与其中之一一致
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx1024m

# ---------------------------------------------------------------- 出厂默认值收口自检
# 启动自检（ProductionConfigGuard）会把下一节列出的「出厂示例值」逐项比对，**命中即拒绝启动**。
# 它对**所有 profile** 生效（含默认的 dev）——因为默认部署同样会把认证根交出去；原实现只认 prod，
# 导致「按默认方式部署」恰好落在盲区。
#   enforce（默认）：命中即拒绝启动；prod 下恒为该档，本开关无效
#   warn：命中只打 WARN 不阻断，**只允许非 prod 使用**，供本地开发沿用出厂口令
BIZBUDDY_SECURITY_GUARD_MODE=enforce

# ---------------------------------------------------------------- 不得沿用出厂示例值的配置项
# 请由部署环境（compose environment / 外部 secret）注入；本地开发确需沿用出厂值时，把上面的开关设为 warn：
#   SA_TOKEN_JWT_SECRET_KEY    Sa-Token JWT 秘钥              默认 abcdefghijklmnopqrstuvwxyz
#   BIZBUDDY_AI_CRYPTO_KEY     模型密钥加密根（16/24/32 位）  默认 bizbuddy-ai-2026
#   API_DECRYPT_PUBLIC_KEY     接口加密响应公钥               默认随源码公开
#   API_DECRYPT_PRIVATE_KEY    接口加密请求私钥               默认随源码公开
#   SNAILJOB_TOKEN             SnailJob 接入令牌              默认随源码公开
# 另需替换口令类默认值：POSTGRES_PASSWORD / REDIS_PASSWORD / MILVUS_PASSWORD（见上文）。
# 注意：前端 `VITE_APP_RSA_*` 必须与 `API_DECRYPT_*` 成对更换，否则登录（RSA 解密）会失败。
