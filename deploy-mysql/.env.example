# ==========================================================================================
# BizBuddy 部署变量（MySQL 8.0 版；复制为 .env 后生效；不复制则使用 docker-compose.yml 内的默认值）
#
#   cp .env.example .env
#
# 注意：MySQL 的建库脚本只在数据卷为空的首次启动时执行；
#       改完这些变量后如需重建库，请执行 `docker compose down -v` 再起。
#
# 端口整体与 deploy/（PostgreSQL 版）错开，两套编排可同时运行。
# ==========================================================================================

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 对外端口
WEB_PORT=81
BACKEND_PORT=8081
SNAILJOB_DASHBOARD_PORT=8801
SNAILJOB_SERVER_PORT=17889
MYSQL_PORT=3306
REDIS_PORT=6380
MILVUS_PORT=19531
MILVUS_METRICS_PORT=9092

# ---------------------------------------------------------------- 数据库（MySQL 8.0）
# MySQL 8 默认认证插件为 caching_sha2_password，JDBC 非 SSL 连接须带 allowPublicKeyRetrieval=true
# （见 config/application-dev.yml），此处用 root 账号，无需额外建业务账号。
MYSQL_IMAGE=mysql:8.0
MYSQL_DATABASE=biz_buddy
MYSQL_USERNAME=root
# 与 jdbc 密码保持一致；含特殊字符时无需转义（纯作为字符串使用）
MYSQL_PASSWORD=Zl@2026

# ---------------------------------------------------------------- 缓存
REDIS_PASSWORD=Zl@2026

# ---------------------------------------------------------------- 平台对象存储（OSS）
# RuoYi 的文件上传与知识库文档存在这里（配置在数据库 sys_oss_config，由 50-oss-endpoint.sql 指向 minio:9000）
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
OSS_ACCESS_KEY=ruoyi
OSS_SECRET_KEY=ruoyi123
OSS_BUCKET=ruoyi

# ---------------------------------------------------------------- 向量库
# Milvus standalone 默认开启鉴权，超级用户 root / Milvus
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus

# Milvus 依赖的对象存储镜像。MinIO 官方已停止在 Docker Hub 发布，
# Milvus 官方编排里钉的旧 tag 已拉不到，故此处默认用仍可拉取的 release。
# 若拉取失败，可改用社区 fork：pgsty/minio:RELEASE.2026-04-17T00-00-00Z
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z

# ---------------------------------------------------------------- 后端
# 建库脚本会创建 dev / prod 两个 SnailJob 命名空间，取值须与其中之一一致
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx1024m