{
  "App": {
    "SelfUrl": "https://localhost:44362",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.Learn.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../../Learn.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44362",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "Learn_Swagger",
    "CertificatePassPhrase": "d9e67d8d-bedd-4e1f-aa70-58d69c9f5831"
  },
  "StringEncryption": {
