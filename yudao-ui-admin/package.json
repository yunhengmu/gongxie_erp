    "build": "pnpm vite build --mode production",
    "build:analyze": "pnpm vite build --mode analyze",
    "preview": "vite preview",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vue-tsc --noEmit --skipLibCheck",
